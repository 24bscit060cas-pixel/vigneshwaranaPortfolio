<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Vigneshwarana G - Portfolio</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 20px;
    }
    .container {
      background-color: white;
      max-width: 600px;
      margin: 0 auto;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h1 {
      text-align: center;
      color: #333;
    }
    h2 {
      color: #444;
    }
    ul {
      list-style-type: disc;
      padding-left: 20px;
    }
    button {
      margin-top: 15px;
      padding: 10px 20px;
      font-size: 16px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover {
      background-color: #0056b3;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>Vigneshwarana G</h1>
    <h2>Skills</h2>
    <ul id="skills-list">
      <li>Java</li>
      <li>C</li>
      <li>Python</li>
    </ul>

    <button onclick="addSkill()">Add More Skill</button>
  </div>

  <script>
    function addSkill() {
      const skill = prompt("Enter a new skill:");
      if (skill && skill.trim() !== "") {
        const ul = document.getElementById("skills-list");
        const li = document.createElement("li");
        li.textContent = skill.trim();
        ul.appendChild(li);
      } else {
        alert("Please enter a valid skill.");
      }
    }
  </script>

</body>
</html>
